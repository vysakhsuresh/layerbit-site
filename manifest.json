{
  "name": "Layerbit — Free Developer Tools",
  "short_name": "Layerbit",
  "description": "Free developer tools that run in your browser: JSON, JWT, regex, SQL, diff, passwords, colors and more. No installs, no sign-up.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#0a0c10",
  "theme_color": "#0a0c10",
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "file_handlers": [
    {
      "action": "/tools/json-validator.html",
      "accept": {
        "application/json": [
          ".json"
        ]
      },
      "launch_type": "single-client"
    },
    {
      "action": "/tools/csv-to-json.html",
      "accept": {
        "text/csv": [
          ".csv"
        ],
        "text/tab-separated-values": [
          ".tsv"
        ]
      },
      "launch_type": "single-client"
    },
    {
      "action": "/tools/xml-formatter.html",
      "accept": {
        "application/xml": [
          ".xml"
        ],
        "text/xml": [
          ".xml"
        ]
      },
      "launch_type": "single-client"
    },
    {
      "action": "/tools/yaml-json-converter.html",
      "accept": {
        "application/yaml": [
          ".yaml",
          ".yml"
        ],
        "text/yaml": [
          ".yaml",
          ".yml"
        ]
      },
      "launch_type": "single-client"
    },
    {
      "action": "/tools/log-analyzer.html",
      "accept": {
        "text/plain": [
          ".log"
        ]
      },
      "launch_type": "single-client"
    },
    {
      "action": "/tools/markdown-preview.html",
      "accept": {
        "text/markdown": [
          ".md",
          ".markdown"
        ]
      },
      "launch_type": "single-client"
    },
    {
      "action": "/tools/text-diff-checker.html",
      "accept": {
        "text/x-diff": [
          ".patch",
          ".diff"
        ],
        "text/plain": [
          ".txt"
        ]
      },
      "launch_type": "single-client"
    }
  ]
}
